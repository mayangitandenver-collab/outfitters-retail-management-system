@page "/"
@inject IApiClient ApiClient

<PageTitle>Dashboard - OUTFITTERS</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">Overview</span>
        <h1>Store Dashboard</h1>
        <p>Live retail performance and operational alerts.</p>
    </div>
    <button class="primary-button compact">New Sale</button>
</div>

@if (_loading)
{
    <div class="page-card">Loading dashboard...</div>
}
else
{
    <div class="metric-grid">
        <article class="metric-card">
            <span>Today's Sales</span>
            <strong>@_summary.TodaySales.ToString("C")</strong>
        </article>
        <article class="metric-card">
            <span>Monthly Sales</span>
            <strong>@_summary.MonthSales.ToString("C")</strong>
        </article>
        <article class="metric-card">
            <span>Inventory Value</span>
            <strong>@_summary.InventoryValue.ToString("C")</strong>
        </article>
        <article class="metric-card alert-card">
            <span>Low Stock Items</span>
            <strong>@_summary.LowStockCount</strong>
        </article>
        <article class="metric-card">
            <span>Active Customers</span>
            <strong>@_summary.ActiveCustomers</strong>
        </article>
        <article class="metric-card">
            <span>Transactions Today</span>
            <strong>@_summary.TransactionsToday</strong>
        </article>
    </div>

    <div class="dashboard-grid">
        <section class="page-card">
            <div class="section-heading">
                <h2>Sales trend</h2>
                <span>Current month</span>
            </div>

            @if (_summary.SalesTrend.Count == 0)
            {
                <div class="empty-state">Sales data will appear here.</div>
            }
            else
            {
                <div class="trend-list">
                    @foreach (var item in _summary.SalesTrend)
                    {
                        <div>
                            <span>@item.Label</span>
                            <strong>@item.Value.ToString("C")</strong>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="page-card">
            <div class="section-heading">
                <h2>Top products</h2>
                <span>By sales</span>
            </div>

            @if (_summary.TopProducts.Count == 0)
            {
                <div class="empty-state">Top-selling products will appear here.</div>
            }
            else
            {
                <div class="product-list">
                    @foreach (var item in _summary.TopProducts)
                    {
                        <div>
                            <span>@item.Name</span>
                            <strong>@item.SalesAmount.ToString("C")</strong>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private DashboardSummary _summary = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _summary = await ApiClient.GetDashboardAsync();
        _loading = false;
    }
}
