        </div>

        <nav class="navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/pos">Point of Sale</NavLink>
            <NavLink href="/products">Products</NavLink>
                      <NavLink href="/inventory">Inventory</NavLink>
                      <NavLink href="/purchasing">Purchasing</NavLink>
                      <NavLink href="/purchasing/orders/new">New Purchase Order</NavLink>
                      <NavLink href="/purchasing/receiving">Goods Receiving</NavLink>
