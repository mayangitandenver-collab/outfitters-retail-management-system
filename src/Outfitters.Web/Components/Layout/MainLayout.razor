@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">O</div>
            <div>
                <strong>OUTFITTERS</strong>
                <span>Retail Management</span>
            </div>
        </div>

        <nav class="navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/pos">Point of Sale</NavLink>
            <NavLink href="/inventory">Inventory</NavLink>
            <NavLink href="/customers">Customers</NavLink>
            <NavLink href="/employees">Employees</NavLink>
            <NavLink href="/finance">Finance</NavLink>
            <NavLink href="/reports">Reports</NavLink>
            <NavLink href="/settings">Settings</NavLink>
        </nav>
    </aside>

    <main class="main-area">
        <header class="topbar">
            <div>
                <span class="store-label">Current store</span>
                <strong>Main Branch</strong>
            </div>
            <div class="topbar-actions">
                <button type="button" class="ghost-button">Notifications</button>
                <div class="user-chip">Administrator</div>
            </div>
        </header>

        <section class="content-area">
            @Body
        </section>
    </main>
</div>
