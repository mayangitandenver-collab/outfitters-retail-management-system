                      <NavLink href="/customers/loyalty-tools">Loyalty Tools</NavLink>
                      <NavLink href="/customers/gift-cards">Gift Cards</NavLink>
            <NavLink href="/employees">Employees</NavLink>
                      <NavLink href="/hr">HR Dashboard</NavLink>
                      <NavLink href="/hr/attendance">Attendance</NavLink>
                      <NavLink href="/hr/scheduling">Shifts and Leave</NavLink>
            <NavLink href="/finance">Finance</NavLink>
            <NavLink href="/reports">Reports</NavLink>
                      <NavLink href="/reports/sales-analytics">Sales Analytics</NavLink>
